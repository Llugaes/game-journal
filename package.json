{
  "name": "game-journal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "journal:build": "node scripts/build-journal-index.mjs",
    "build": "npm run journal:build && tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test scripts/steam/*.test.mjs",
    "steam:collect": "node scripts/steam-import.mjs collect",
    "steam:plan": "node scripts/steam-import.mjs plan",
    "steam:apply": "node scripts/steam-import.mjs apply",
    "steam:sync": "node scripts/steam-import.mjs sync --refresh"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "cheerio": "^1.1.2",
    "sharp": "^0.35.5"
  }
}
